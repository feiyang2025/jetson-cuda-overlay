- visionipc_pyx: 新增 write_and_send: get_buffer 一次, 写完发送同一 buffer(分开 get/send 会拿两个不同 buffer)
- visionbuf_jetson.cc: CUDA 映射完善(__JETSON__ 路径), cudaHostRegister 映射内存 kernel 可读写
- visionipc_server/client: refcount 同步, 客户端 recv acquire / 用完 release
- 供 sunnypilot-cuda AGXOrin 分支相机链路使用
---
 msgq/visionipc/visionbuf.h         | 10 +++++++++
 msgq/visionipc/visionbuf_jetson.cc |  6 +++++-
 msgq/visionipc/visionipc.pxd       |  4 ++++
 msgq/visionipc/visionipc_client.cc |  3 +++
 msgq/visionipc/visionipc_pyx.pyx   | 34 ++++++++++++++++++++++++++++--
 msgq/visionipc/visionipc_server.cc | 17 ++++++++++++++-
 6 files changed, 70 insertions(+), 4 deletions(-)

diff --git a/msgq/visionipc/visionbuf.h b/msgq/visionipc/visionbuf.h
index ca167df..c6272ed 100644
--- a/msgq/visionipc/visionbuf.h
+++ b/msgq/visionipc/visionbuf.h
@@ -2,6 +2,8 @@
 
 #include "msgq/visionipc/visionipc.h"
 
+#include <atomic>
+
 #define CL_USE_DEPRECATED_OPENCL_1_2_APIS
 #ifdef __APPLE__
 #include <OpenCL/cl.h>
@@ -43,6 +45,14 @@ class VisionBuf {
   size_t idx = 0;
   VisionStreamType type;
 
+  // Shared refcount: 客户端 recv 时 +1 (acquire), 用完 -1 (release);
+  // server 端写入前等待 ref_count==0, 防止读写竞争导致画面撕裂。
+  std::atomic<uint64_t> *ref_count = nullptr;
+
+  void acquire() { if (ref_count) (*ref_count)++; }
+  void release() { if (ref_count) (*ref_count)--; }
+  uint64_t get_ref_count() { return ref_count ? ref_count->load() : 0; }
+
   // OpenCL
   cl_mem buf_cl = nullptr;
   cl_command_queue copy_q = nullptr;
diff --git a/msgq/visionipc/visionbuf_jetson.cc b/msgq/visionipc/visionbuf_jetson.cc
index d999ec1..eb97bcb 100644
--- a/msgq/visionipc/visionbuf_jetson.cc
+++ b/msgq/visionipc/visionbuf_jetson.cc
@@ -40,9 +40,12 @@ static void *malloc_with_fd(size_t len, int *fd) {
 
 void VisionBuf::allocate(size_t length) {
   this->len = length;
-  this->mmap_len = this->len + sizeof(uint64_t);
+  // 元数据区: [frame_id (8B)] [ref_count (8B)]
+  this->mmap_len = this->len + 2 * sizeof(uint64_t);
   this->addr = malloc_with_fd(this->mmap_len, &this->fd);
   this->frame_id = (uint64_t*)((uint8_t*)this->addr + this->len);
+  this->ref_count = (std::atomic<uint64_t>*)((uint8_t*)this->addr + this->len + sizeof(uint64_t));
+  *this->ref_count = 0;
 
 #ifdef __JETSON__
   cudaError_t err = cudaHostRegister(this->addr, this->mmap_len,
@@ -65,6 +68,7 @@ void VisionBuf::import() {
   this->addr = mmap(NULL, this->mmap_len, PROT_READ | PROT_WRITE, MAP_SHARED, this->fd, 0);
   assert(this->addr != MAP_FAILED);
   this->frame_id = (uint64_t*)((uint8_t*)this->addr + this->len);
+  this->ref_count = (std::atomic<uint64_t>*)((uint8_t*)this->addr + this->len + sizeof(uint64_t));
 
 #ifdef __JETSON__
   cudaError_t err = cudaHostRegister(this->addr, this->mmap_len, cudaHostRegisterMapped);
diff --git a/msgq/visionipc/visionipc.pxd b/msgq/visionipc/visionipc.pxd
index 046430f..827fbca 100644
--- a/msgq/visionipc/visionipc.pxd
+++ b/msgq/visionipc/visionipc.pxd
@@ -1,4 +1,5 @@
 # distutils: language = c++
